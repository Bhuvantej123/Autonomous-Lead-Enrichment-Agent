# ── Groq ───────────────────────────────────────────────────────────────────
# Your Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=

# Groq model to use for extraction
# Options: llama-3.3-70b-versatile | llama3-70b-8192 | mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# ── Crawler ────────────────────────────────────────────────────────────────
# Max pages to crawl per domain (homepage + subpages)
MAX_PAGES_PER_DOMAIN=8

# Page-load timeout in seconds (converted to ms internally)
BROWSER_TIMEOUT_SECONDS=20

# ── Extractor ──────────────────────────────────────────────────────────────
# Max characters kept per individual page before combining
MAX_CHARS_PER_PAGE=4000

# Max total characters sent to the LLM across all pages
MAX_CHARS_COMBINED=24000

# ── Pipeline ───────────────────────────────────────────────────────────────
# Output file path (relative to project root)
OUTPUT_FILE=output/output.json

# ── Web Search Enrichment (Fallback) ─────────────────────────────────────────
# Enable/disable targeted web search fallback when website data is incomplete
SEARCH_ENABLED=false

# Serper.dev API key — get 2,500 free queries at https://serper.dev
SEARCH_API_KEY=646e4dd40ec9aebc1c790c59db5528829d73bad2

# Max organic search results to fetch per query (1–10)
SEARCH_MAX_RESULTS=3
